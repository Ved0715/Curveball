# Copy to backend/.env and fill in. Never commit backend/.env.

# Which AI provider to use: gemini (default) or anthropic.
AI_PROVIDER=gemini

# Google Gemini API key (https://aistudio.google.com/apikey). Server-only.
GEMINI_API_KEY=

# Anthropic API key, only needed when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# true = canned AI responses (no key needed, free). false = real AI calls.
AI_MOCK=false

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Postgres connection string (Neon). Apply schema with: uv run alembic upgrade head
DATABASE_URL=

# Optional overrides (defaults live in app/config.py):
# GEMINI_MODELS_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MODELS_BALANCED=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# GEMINI_MODELS_CAPABLE=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# GEMINI_THINKING_FAST=minimal
# MAX_AI_CALLS_PER_DAY=150
