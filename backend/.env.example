# Copy to backend/.env and fill in. Never commit backend/.env.

# Anthropic API key (https://platform.claude.com/settings/keys). Server-only.
ANTHROPIC_API_KEY=

# true = canned AI responses (no key needed, free). false = real Claude calls.
AI_MOCK=true

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Postgres connection string. Not used until Phase 2.
DATABASE_URL=

# Optional model overrides (defaults live in app/config.py).
# MODEL_FAST=claude-haiku-4-5
# MODEL_BALANCED=claude-sonnet-5
# MODEL_CAPABLE=claude-opus-5
