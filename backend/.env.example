# Copy to backend/.env and fill in. Never commit backend/.env.

# Which AI provider to use: gemini (default), anthropic, or openai (any server that
# speaks the OpenAI Chat Completions protocol - an internal gateway, a self-hosted
# vLLM server, etc.).
AI_PROVIDER=gemini

# Google Gemini API key (https://aistudio.google.com/apikey). Server-only.
GEMINI_API_KEY=

# Anthropic API key, only needed when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Only needed when AI_PROVIDER=openai. AI_BASE_URL is the gateway's OpenAI-compatible
# root (e.g. https://your-gateway.example.com/v1). AI_MODEL is the model name the
# gateway expects.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=qwen-3.8-27b
# Reasoning effort per tier: none/low/medium/xhigh (values vary by gateway; check yours).
# Reasoning tokens count against max_tokens, so keep AI_REASONING_FAST cheap or fast
# calls (interviewer turns, hints) can be cut off before any real answer.
# AI_REASONING_FAST=none
# AI_REASONING_BALANCED=low
# AI_REASONING_CAPABLE=medium

# true = canned AI responses (no key needed, free). false = real AI calls.
AI_MOCK=false

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Public address of the web app. Google sends people back to APP_URL/api/auth/google/callback.
APP_URL=http://localhost:3000

# Sign in with Google: Google Cloud console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/google/callback  (plus your production URL later)
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres connection string (Neon). Apply schema with: uv run alembic upgrade head
DATABASE_URL=

# Optional overrides (defaults live in app/config.py):
# GEMINI_MODELS_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MODELS_BALANCED=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# GEMINI_MODELS_CAPABLE=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# GEMINI_THINKING_FAST=minimal
# MAX_AI_CALLS_PER_DAY=150
